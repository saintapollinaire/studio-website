---
import { STUDIO_NAME } from '../config/site';
import { navPages, otherLocale, pathFor, t, type Locale, type PageId } from '../i18n';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const strings = t(locale);
const alt = otherLocale(locale);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__name" href={pathFor('home', locale)}>{STUDIO_NAME}</a>
    <nav class="header__nav" aria-label={strings.nav.label}>
      <ul>
        {
          navPages.map((id) => (
            <li>
              <a href={pathFor(id, locale)} aria-current={id === page ? 'page' : undefined}>
                {strings.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="header__lang"
      href={pathFor(page, alt)}
      hreflang={alt}
      lang={alt}
      aria-label={strings.nav.switchLanguageLabel}
    >
      {strings.nav.switchLanguage}
    </a>
  </div>
</header>

<style>
  .header {
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-6);
  }

  .header__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    text-decoration: none;
    margin-right: auto;
  }

  .header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .header__nav a,
  .header__lang {
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .header__nav a[aria-current='page'] {
    text-decoration: underline;
  }

  .header__lang {
    color: var(--color-text-muted);
  }

  @media (max-width: 40rem) {
    .header__nav {
      order: 3;
      width: 100%;
    }
  }
</style>
